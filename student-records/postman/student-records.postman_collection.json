{
  "info": {
    "name": "Student Records API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9090" },
    { "key": "token", "value": "" },
    { "key": "studentId", "value": "" }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"asha\",\n  \"password\": \"secret123\"\n}" },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Login",
      "event": [{
        "listen": "test",
        "script": { "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"asha\",\n  \"password\": \"secret123\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Create Student",
      "event": [{
        "listen": "test",
        "script": { "exec": ["pm.collectionVariables.set('studentId', pm.response.json().id);"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Asha Rao\",\n  \"age\": 20,\n  \"course\": \"B.Tech CSE\",\n  \"email\": \"asha@example.com\"\n}" },
        "url": "{{baseUrl}}/students"
      }
    },
    {
      "name": "Get All Students",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{baseUrl}}/students"
      }
    },
    {
      "name": "Get Student By ID",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{baseUrl}}/students/{{studentId}}"
      }
    },
    {
      "name": "Update Student",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Asha Rao\",\n  \"age\": 21,\n  \"course\": \"B.Tech CSE\",\n  \"email\": \"asha.rao@example.com\"\n}" },
        "url": "{{baseUrl}}/students/{{studentId}}"
      }
    },
    {
      "name": "Delete Student",
      "request": {
        "method": "DELETE",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
        "url": "{{baseUrl}}/students/{{studentId}}"
      }
    }
  ]
}
